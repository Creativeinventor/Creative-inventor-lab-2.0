# ==============================================================================
# CREATIVE INVENTOR LAB - Environment Variables Configuration
# ==============================================================================
# Project ID: creative-inventor-lab
#
# HOW TO OBTAIN THESE CREDENTIALS FROM FIREBASE CONSOLE:
# 1. Open Firebase Console: https://console.firebase.google.com/
# 2. Open project: "creative-inventor-lab" (or create it if needed)
# 3. Click the gear icon (⚙️) next to "Project Overview" -> Select "Project settings"
# 4. Under the "General" tab, scroll down to the "Your apps" card
# 5. Select your Web App (or click "</>" to register one: "Creative Inventor Lab")
# 6. Under "Firebase SDK snippet", select the "Config" radio button
# 7. Copy the values into your local ".env.local" file or Vercel Environment Variables:
# ==============================================================================

# 1. apiKey: Web API Key generated for your Firebase project
VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKeyHere"

# 2. authDomain: Authentication domain (e.g. creative-inventor-lab.firebaseapp.com)
VITE_FIREBASE_AUTH_DOMAIN="creative-inventor-lab.firebaseapp.com"

# 3. projectId: The unique Firebase project ID
VITE_FIREBASE_PROJECT_ID="creative-inventor-lab"

# 4. storageBucket: Cloud Storage bucket URL (e.g. creative-inventor-lab.firebasestorage.app or .appspot.com)
VITE_FIREBASE_STORAGE_BUCKET="creative-inventor-lab.firebasestorage.app"

# 5. messagingSenderId: Cloud Messaging Sender ID (numeric ID from Project settings)
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"

# 6. appId: Web App ID (e.g. 1:123456789012:web:abcdef123456)
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# Optional: Administrator email domain mapping (default: creativeinventorlab.internal)
VITE_ADMIN_EMAIL_DOMAIN="creativeinventorlab.internal"

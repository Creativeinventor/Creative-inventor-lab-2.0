rules_version = '2';

// Firebase Cloud Storage security rules for Creative Inventor Lab
service firebase.storage {
  match /b/{bucket}/o {
    // Default deny for unmatched paths
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Admin uploads folder: Only authenticated administrators can read, upload, and delete
    match /uploads/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.resource.size < 500 * 1024 * 1024; // 500MB safety ceiling per file
      allow delete: if request.auth != null;
    }
  }
}

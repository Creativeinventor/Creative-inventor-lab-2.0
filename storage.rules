rules_version = '2';

// Firebase Cloud Storage security rules for Creative Inventor Lab
service firebase.storage {
  match /b/{bucket}/o {
    // Default deny for unmatched paths
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isAuthorizedAdmin() {
      return request.auth != null &&
        request.auth.token.email == '20sgamingrohit@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    // Admin uploads folder: Strictly restricted to 20sgamingrohit@gmail.com
    match /uploads/{allPaths=**} {
      allow read: if isAuthorizedAdmin();
      allow write: if isAuthorizedAdmin() &&
        request.resource.size < 500 * 1024 * 1024; // 500MB safety ceiling per file
      allow delete: if isAuthorizedAdmin();
    }
  }
}
